# vim: set filetype=sh :

export GENERATE_UNIQUE_PORT=true
export OPENCODE_EXPERIMENTAL_LSP_TOOL=true

setup_startup_hook() {
    check_stable_internet() {
        check_internet() { curl -sSf --max-time 5 -o /dev/null "https://1.1.1.1"; }
        log "Checking internet stability" 1 false false
        local attempts=3 success=0
        for _ in {1..3}; do
            check_internet >/dev/null 2>&1 && { printf "."; ((success++)); }
            sleep 1
        done
        printf "\n"
        [[ $success -eq $attempts ]]
    }
    check_stable_internet || { error "❌ Unstable internet connection detected"; exit 1; }
    log "Setting up system for server use" 1 true
    pkill -f swayidle
}

setup_layout_custom() {
    create_window "Web Server" "uv run fastapi run --port $(generate_port)"
    create_window "Editor (Web)" "uv run nvim"
}

setup_post_exit_hook() {
    intention linux
}
