# News Flow environment configuration.
# Copy this file to `.env` and fill in the values. Values already present in
# the real environment always take precedence over `.env`. No inline comments
# after values.

# --- WordPress publishing ---------------------------------------------------
# Site completed articles are published to (no trailing slash).
WORDPRESS_URL=https://keralapranamam.com

# WordPress username and an application password for non-interactive API auth
# (wp-admin → Users → Profile → Application Passwords).
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Optional: numeric ID of the category every published post is filed under.
# Leave empty to use the site default. The ID appears in the URL when editing
# the category in wp-admin (…/term.php?taxonomy=category&tag_ID=123).
WORDPRESS_CATEGORY_ID=

# --- Google Gemini (auto-categorization) ------------------------------------
# When set, accepted articles are sent to Gemini along with the site's
# categories/tags and the related categories are marked on the post before
# publishing. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-2.5-flash).
GEMINI_MODEL=
